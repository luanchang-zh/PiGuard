[Unit]
Description=PiGuard platform API
Requires=piguard-mqtt.service
After=network-online.target piguard-mqtt.service
Wants=network-online.target

[Service]
Type=simple
User=piguard
Group=piguard
WorkingDirectory=/opt/piguard/current
EnvironmentFile=/etc/piguard/backend.env
ExecStart=/opt/piguard/current/server -config /opt/piguard/current/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/piguard

[Install]
WantedBy=multi-user.target
