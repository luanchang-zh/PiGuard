# 课设测试账号，与 edge/config/raspberrypi-demo.yaml 配套。
PIGUARD_HTTP_ADDR=0.0.0.0:8080
PIGUARD_HTTP_AUTH_DISABLED=false
PIGUARD_HTTP_PLATFORM_USERNAME=platform
PIGUARD_HTTP_PLATFORM_PASSWORD=piguard-platform-http-demo
PIGUARD_HTTP_SEED_DEVICE_PASSWORD=piguard-device-http-demo
PIGUARD_HTTP_SESSION_TTL_MINUTES=30
PIGUARD_HTTP_ALLOWED_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173","http://192.168.43.121:5173"]'
PIGUARD_SEED_DEVICE_ID=car-001
PIGUARD_SEED_MODE=mock
PIGUARD_MQTT_BROKER=tcp://127.0.0.1:1883
PIGUARD_MQTT_USERNAME=platform
PIGUARD_MQTT_PASSWORD=piguard-platform-mqtt-demo
PIGUARD_DEVICE_MQTT_PASSWORD=piguard-device-mqtt-demo
PIGUARD_BROKER_HEALTH_USERNAME=broker-health
PIGUARD_BROKER_HEALTH_PASSWORD=piguard-broker-health-demo
PIGUARD_DATABASE_SQLITE_PATH=data/demo/piguard.db
PIGUARD_STORAGE_SNAPSHOT_DIR=data/demo/snapshots
