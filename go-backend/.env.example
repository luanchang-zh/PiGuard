# 复制为 .env；填写每个密码。不要提交真实凭据。
PIGUARD_HTTP_PLATFORM_USERNAME=platform
PIGUARD_HTTP_PLATFORM_PASSWORD=
PIGUARD_HTTP_SEED_DEVICE_PASSWORD=
PIGUARD_HTTP_SESSION_TTL_MINUTES=30
# 同一 IP/域名、同 scheme；空列表仅后端同源。实际端口由前端部署决定。
PIGUARD_HTTP_ALLOWED_ORIGINS=[]
PIGUARD_SEED_DEVICE_ID=car-001
PIGUARD_MQTT_USERNAME=platform
PIGUARD_MQTT_PASSWORD=
PIGUARD_DEVICE_MQTT_PASSWORD=
PIGUARD_BROKER_HEALTH_USERNAME=broker-health
PIGUARD_BROKER_HEALTH_PASSWORD=
